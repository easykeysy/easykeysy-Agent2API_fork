# LAW-11.R2 mode flag (final ruling 2026-11-16, recorded in LAW.md LAW-11.R3).
# leave   = bare upstream tag names must keep pointing at the upstream commit
# repoint = bare upstream tag name is re-pointed to the fork release
#           (flipping requires a new maintainer ruling recorded in LAW.md)
BARE_UPSTREAM_TAG_MODE=leave
