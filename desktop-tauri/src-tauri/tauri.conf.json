{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent2API",
  "mainBinaryName": "agent2api",
  "version": "3.5.0-beta.1",
  "identifier": "com.workbuddy.local-proxy",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Agent2API",
    "copyright": "Copyright (c) 2026 Agent2API",
    "targets": [
      "nsis"
    ],
    "resources": [
      "../ui",
      "../../licenses",
      "../../LICENSE"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis-hooks.nsh",
        "template": "nsis-template.nsi",
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "shortDescription": "Agent2API · Multi-provider local gateway",
    "longDescription": "Packages multiple AI client login states (WorkBuddy, Little Raccoon, etc.) as a local OpenAI-compatible API, and centrally manages multi-account, outbound proxy, and content redaction. The gateway is now fully implemented in Rust and runs inside the app process; no external runtime is shipped with the package, so installs are small and ready to use out of the box."
  }
}
