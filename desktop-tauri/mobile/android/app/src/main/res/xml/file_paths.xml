<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider shared path.

  `cache-path` overwrite `getCacheDir()`: the in-app update downloads the APK to
  `cache/updates/agent2api-update.apk`, the installer gets the content:// URI through here.
  The original`external-path` —— Capacitor 's file-related plugins work by it.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="my_images" path="." />
    <cache-path name="my_cache_images" path="." />
</paths>
