<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Agent2API</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  App Transport Security(ATS).

	  ── Why open up plaintext http─────────────────────────────────────
	  The gateway runs on a LAN and usually has no certificate; the address entered in the app is
	  `http://192.168.x.x:3065` this form. iOS blocks all plaintext connections by default,
	  On WKWebView in it only appears as a fetch failure, and the UI shows no reason at all.

	  ── Why both keys need to be enabled───────────────────────────────────────
	  · NSAllowsArbitraryLoads         —— overwrite URLSession one side (native plugins,
	    as well as the requests that go through URLSession inside the WebView).
	  · NSAllowsArbitraryLoadsInWebContent —— overwrite WKWebView page requests in it.
	    Be aware that once it appears, the system **ignores** NSAllowsArbitraryLoads (Apple",
	    the documentation states this priority explicitly), so write both to guarantee the native and web paths both
	    All links are let through.
	  · NSAllowsLocalNetworking —— iOS 17 onward, ATS blocks even "IP addresses" by default,
	    This entry allows private network segments and .local domains. The gateway address is entered by the user, and may fall into",
	    10.x / 172.16-31.x / 192.168.x / 100.64.x(tailscale), not enumerable,
	    so it can only be opened up as a whole.

	  ── The risk surface───────────────────────────────────────────────────
	  and Android — see the network_security_config The same trade-off: plaintext only affects the "link",
	  The panel still requires an admin login; the risk is that passwords and tokens can be sniffed within the same LAN. To eliminate
	  It just configures TLS for the gateway, then enter the https address in the app (the code takes the same path).",
	  These items need their purpose (LAN device management) explained in the review notes when submitting to the App Store.",
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!--
	  Accessing LAN devices requires user permission (iOS 14+). Without this entry, the first time you connect to the gateway it",
	  It fails outright with no hint, and the user has no idea where to enable the permission.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Used to connect to the Agent2API gateway you run on your LAN.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_https._tcp</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
