{
  "name": "agent2api",
  "version": "3.5.0-beta.1",
  "description": "Agent2API - AI Routing gateway and Agent client takeover: unified model interface, account routing, gateway keys and request reports; provider capabilities are extended via standalone plugins",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "test:rust": "node scripts/cargo-test.mjs",
    "test:rust:plugins": "node scripts/cargo-test.mjs --plugins",
    "test:rust:coverage": "node scripts/cargo-test.mjs --coverage",
    "build:icon": "node build/make-icon.mjs",
    "tauri:install": "npm --prefix desktop-tauri install",
    "tauri:dev": "npm --prefix desktop-tauri run dev",
    "tauri:build": "npm --prefix desktop-tauri run build",
    "mobile:install": "npm --prefix desktop-tauri/mobile install",
    "mobile:build": "npm --prefix desktop-tauri/mobile run build",
    "mobile:watch": "npm --prefix desktop-tauri/mobile run watch",
    "ui:islands": "npm --prefix desktop-tauri/ui-islands run build"
  },
  "keywords": [
    "agent2api",
    "workbuddy",
    "raccoon",
    "catpaw",
    "autoclaw",
    "codebuddy",
    "tencent",
    "api",
    "proxy",
    "openai",
    "sse",
    "llm"
  ],
  "author": "Agent2API",
  "repository": {
    "type": "git",
    "url": "https://github.com/aimod-cc/Agent2API.git"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18.17.0"
  }
}
